{
    "id": "org.kde.kweather",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.11",
    "sdk": "org.kde.Sdk",
    "command": "kweather",
    "finish-args": [
        "--share=ipc",
        "--share=network",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--system-talk-name=org.freedesktop.GeoClue2"
    ],
    "cleanup": [
        "/include",
        "/lib/cmake",
        "/mkspecs",
        "/share/plasma",
        "/share/qlogging-categories6"
    ],
    "modules": [
        {
            "name": "kweathercore",
            "config-opts": [
                "-DBUILD_TESTING=OFF",
                "-DCMAKE_BUILD_TYPE=RelWithDebInfo"
            ],
            "buildsystem": "cmake-ninja",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/release-service/26.08.3/src/kweathercore-26.08.3.tar.xz",
                    "sha256": "9a22fee16ba887b200c46e5add3e7250e05aa1df97768145390eaf6677e7f485",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 8763,
                        "stable-only": true,
                        "url-template": "https://download.kde.org/stable/release-service/$version/src/kweathercore-$version.tar.xz"
                    }
                }
            ]
        },
        {
            "name": "kweather",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DBUILD_KRUNNER=OFF",
                "-DBUILD_PLASMOID=OFF",
                "-DBUILD_TESTING=OFF",
                "-DCMAKE_BUILD_TYPE=RelWithDebInfo"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/release-service/26.08.3/src/kweather-26.08.3.tar.xz",
                    "sha256": "e60625ae9ae84fb621a3d95eb0186dba3bf821fecac5ad1c691418f8888b28ca",
                    "x-checker-data": {
                        "is-main-source": true,
                        "type": "anitya",
                        "project-id": 8763,
                        "stable-only": true,
                        "url-template": "https://download.kde.org/stable/release-service/$version/src/kweather-$version.tar.xz"
                    }
                }
            ]
        }
    ]
}
